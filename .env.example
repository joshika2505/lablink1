# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase credentials (optional; local transactional store runs automatically if unset).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Public Supabase client credentials for Vercel / browser auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SESSION_SECRET: HMAC signing key for server-issued auth session tokens.
SESSION_SECRET=

# ADMIN_EMAIL & ADMIN_INITIAL_PASSWORD: Optional server-side admin credentials when Supabase is not yet connected.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

